          "arguments": "{\"command\":\"echo \\\"--- all,/Test/ ---\\\"; devtodo -G -f 'all,/Test/'; echo \\\"--- all,/alpha/ ---\\\"; devtodo -G -f 'all,/alpha/'; echo \\\"--- +high ---\\\"; devtodo -G -f '+high'; echo \\\"--- -medium ---\\\"; devtodo -G -f '-medium'\"}",
