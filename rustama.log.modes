ession search filter can be specified with\n                        '/<expression>'. eg. '-low,=done,-children' would show\n                        any notes with a priority less than or equal to 'low'\n                        that are marked as done and would not show child notes.\n-v, --verbose           Display verbosely.\n--colour ARG            Override default colours of todo items. Multiple colours\n                        can be specified, separated by commas. eg.\n                        high=red,medium=white. Items are bolded by prefixing\n                        them with a '+'.\n--mono                  Disable all use of colour.\n--force-colour          Force use of colour.\n--help                  Display this help.\n--version               Display version of todo.\n--title [ARG]           Set the title of this directory's todo notes.\n--date-format ARG       Format the display of time values. The format is that\n                        used by strftime(3).\n--format ARG            Specify a display format to use. ARG is in the form\n                        <key>=<format-string>.\n--use-format ARG        Map one format string to another (eg. --use-format\n","role":"tool","tool_call_id":"00e4df06-65b3-41e3-be02-46237d336908"}],"model":"z-ai/glm-5.3","stream":true,"temperature":1.0,"tools":[{"function":{"description":"Read the contents of a file. For large files, use offset/limit to read a window of lines instead of the whole file.","name":"read_file","parameters":{"properties":{"limit":{"description":"Maximum number of lines to return. Default: no limit (whole file).","type":"integer"},"offset":{"description":"First line to return (1-based). Default: 1 (start of file).","type":"integer"},"path":{"description":"The file path to read","type":"string"}},"required":["path"],"type":"object"}},"type":"function"},{"function":{"description":"Write content to a file, creating it if it doesn't exist","name":"write_file","parameters":{"properties":{"content":{"description":"The content to write","type":"string"},"path":{"description":"The file path to write","type":"string"}},"required":["path","content"],"type":"object"}},"type":"function"},{"function":{"description":"Edit a file by replacing old_string with new_string","name":"edit_file","parameters":{"properties":{"new_string":{"description":"The replacement string","type":"string"},"old_string":{"description":"The string to find and replace","type":"string"},"path":{"description":"The file path to edit","type":"string"}},"required":["path","old_string","new_string"],"type":"object"}},"type":"function"},{"function":{"description":"Execute a bash command and return the output","name":"bash","parameters":{"properties":{"command":{"description":"The bash command to execute","type":"string"}},"required":["command"],"type":"object"}},"type":"function"},{"function":{"description":"List files and directories at a path","name":"list_files","parameters":{"properties":{"path":{"description":"The directory path to list","type":"string"}},"required":["path"],"type":"object"}},"type":"function"},{"function":{"description":"Search for files matching a glob pattern","name":"search_files","parameters":{"properties":{"path":{"description":"The directory to search in (defaults to current directory)","type":"string"},"pattern":{"description":"The glob pattern to match (e.g. '**/*.rs')","type":"string"}},"required":["pattern"],"type":"object"}},"type":"function"},{"function":{"description":"Search file contents for a pattern (regex supported). Note: for Rust symbols, prefer lsp_references / lsp_definition — they are compiler-accurate.","name":"search_content","parameters":{"properties":{"include":{"description":"File pattern to include (e.g. '*.rs')","type":"string"},"path":{"description":"The directory to search in","type":"string"},"pattern":{"description":"The regex pattern to search for","type":"string"}},"required":["pattern"],"type":"object"}},"type":"function"},{"function":{"description":"Fetch content from a URL via HTTP/HTTPS GET request","name":"fetch_url","parameters":{"properties":{"url":{"description":"The URL to fetch (http:// or https://)","type":"string"}},"required":["url"],"type":"object"}},"type":"function"},{"function":{"description":"Search the web using DuckDuckGo and return results","name":"web_search","parameters":{"properties":{"query":{"description":"The search query","type":"string"}},"required":["query"],"type":"object"}},"type":"function"},{"function":{"description":"Open a terminal session to run a command in a real PTY — fully interactive programs work (REPLs, ssh, top, vim, even other TUI apps). The terminal panel becomes visible so you can observe the output. Returns JSON with 'status' (message) and 'cursor' (pass this to terminal_read for incremental reads). Use terminal_send to interact (supports escape sequences for special keys) and terminal_read to check output/screen. Use terminal_close when done.","name":"terminal_open","parameters":{"properties":{"command":{"description":"The shell command to run (e.g. 'npm run dev', 'cargo build')","type":"string"}},"required":["command"],"type":"object"}},"type":"function"},{"function":{"description":"Send input (keystrokes) to the running terminal session. The terminal is a real PTY, so interactive programs work. The input is written EXACTLY as given — nothing is appended, so you must include the Enter key yourself: to run a shell command send \"ls -la\\r\" (or end the input with \\r), to drive a TUI send bare keystrokes with no newline (e.g. \"q\" to quit less, \"\\u001bOB\\u001bOB\" for two Down presses in mc). For special keys, write backslash escapes directly in the input string — they are decoded into the real control bytes before being written to the PTY: Enter = \"\\r\", Ctrl+C = \"\\u0003\", Ctrl+D = \"\\u0004\", arrows = \"\\u001b[A/B/C/D\" (up/down/right/left), Tab = \"\\t\", Escape = \"\\u001b\", F1 = \"\\u001bOP\", PgUp/PgDn = \"\\u001b[5~\"/\"\\u001b[6~\". Example: send \"\\u0003\" to interrupt a running program.","name":"terminal_send","parameters":{"properties":{"input":{"description":"The exact bytes to write to the terminal — nothing is appended. Include \\r (Enter) explicitly to submit a line (e.g. \"make build\\r\"). May contain backslash escapes (\\uXXXX, \\n, \\r, \\t) for special keys, which are decoded before sending.","type":"string"}},"required":["input"],"type":"object"}},"type":"function"},{"function":{"description":"Read output from the terminal session. Returns JSON with 'output' (new raw output since 'cursor'), 'cursor' (pass on the next read for incremental output), 'gap' (true if output was lost to buffer overflow), 'screen' (the current rendered terminal screen as text — like a screenshot; this is what shows what full-screen/interactive programs are doing), and 'screen_cursor' (cursor row/col on screen). On the first read, omit 'cursor'. Use 'screen' to understand the current state of interactive/TUI programs.","name":"terminal_read","parameters":{"properties":{"cursor":{"description":"Optional cursor from a previous terminal_read response. When provided, only output written after that cursor is returned. Omit for the first read or to get the full tail window.","type":"integer"}},"type":"object"}},"type":"function"},{"function":{"description":"Close the terminal session and hide the terminal panel. Kills the running process.","name":"terminal_close","parameters":{"properties":{},"type":"object"}},"type":"function"},{"function":{"description":"Get rust-analyzer compiler diagnostics (errors, warnings) for a Rust file. Always use this after editing .rs files to verify your changes compile. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_diagnostics","parameters":{"properties":{"path":{"description":"The .rs file to check. Default: the most recently edited file, else a workspace-wide summary.","type":"string"},"severity":{"description":"Optional filter: error | warning | hint | info. Default: all severities.","type":"string"}},"type":"object"}},"type":"function"},{"function":{"description":"Jump to where a Rust symbol (function, struct, variable, etc.) is defined. Compiler-accurate via rust-analyzer — far more reliable than grep for finding the real definition. Returns the target file, line, column, and a source excerpt. Use whenever you want to know what a call site or name refers to. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_definition","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol reference (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"Get the type signature and documentation of any Rust symbol (function, struct, variable, etc.) at a file position, via rust-analyzer. Faster and more accurate than opening and reading the source file. Use whenever you need to understand what a symbol is or does. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_symbol_info","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"Find every place a Rust symbol is used, via rust-analyzer. Unlike grep, this is compiler-accurate — it won't match same-named symbols in other scopes or files. Returns each reference's file, line, column, and a source excerpt. Prefer this over search_content when working with Rust symbols. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_references","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"include_declaration":{"description":"Whether to include the declaration site itself in the results. Default: true.","type":"boolean"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"List valid code completions (methods, fields, functions, variables) at a cursor position in a Rust file, via rust-analyzer. Use to discover what members a type has or what identifiers are in scope, without reading the source. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_completion","parameters":{"properties":{"column":{"description":"1-based column number of the cursor position.","type":"integer"},"line":{"description":"1-based line number of the cursor position.","type":"integer"},"path":{"description":"The .rs file to complete in (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"}],"top_p":0.95}
