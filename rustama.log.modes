\", arrows = \"\\u001b[A/B/C/D\" (up/down/right/left), Tab = \"\\t\", Escape = \"\\u001b\", F1 = \"\\u001bOP\", PgUp/PgDn = \"\\u001b[5~\"/\"\\u001b[6~\". Example: send \"\\u0003\" to interrupt a running program.","name":"terminal_send","parameters":{"properties":{"input":{"description":"The exact bytes to write to the terminal — nothing is appended. Include \\r (Enter) explicitly to submit a line (e.g. \"make build\\r\"). May contain backslash escapes (\\uXXXX, \\n, \\r, \\t) for special keys, which are decoded before sending.","type":"string"}},"required":["input"],"type":"object"}},"type":"function"},{"function":{"description":"Read output from the terminal session. Returns JSON with 'output' (new raw output since 'cursor'), 'cursor' (pass on the next read for incremental output), 'gap' (true if output was lost to buffer overflow), 'screen' (the current rendered terminal screen as text — like a screenshot; this is what shows what full-screen/interactive programs are doing), and 'screen_cursor' (cursor row/col on screen). On the first read, omit 'cursor'. Use 'screen' to understand the current state of interactive/TUI programs.","name":"terminal_read","parameters":{"properties":{"cursor":{"description":"Optional cursor from a previous terminal_read response. When provided, only output written after that cursor is returned. Omit for the first read or to get the full tail window.","type":"integer"}},"type":"object"}},"type":"function"},{"function":{"description":"Close the terminal session and hide the terminal panel. Kills the running process.","name":"terminal_close","parameters":{"properties":{},"type":"object"}},"type":"function"},{"function":{"description":"Get rust-analyzer compiler diagnostics (errors, warnings) for a Rust file. Always use this after editing .rs files to verify your changes compile. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_diagnostics","parameters":{"properties":{"path":{"description":"The .rs file to check. Default: the most recently edited file, else a workspace-wide summary.","type":"string"},"severity":{"description":"Optional filter: error | warning | hint | info. Default: all severities.","type":"string"}},"type":"object"}},"type":"function"},{"function":{"description":"Jump to where a Rust symbol (function, struct, variable, etc.) is defined. Compiler-accurate via rust-analyzer — far more reliable than grep for finding the real definition. Returns the target file, line, column, and a source excerpt. Use whenever you want to know what a call site or name refers to. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_definition","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol reference (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"Get the type signature and documentation of any Rust symbol (function, struct, variable, etc.) at a file position, via rust-analyzer. Faster and more accurate than opening and reading the source file. Use whenever you need to understand what a symbol is or does. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_symbol_info","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"Find every place a Rust symbol is used, via rust-analyzer. Unlike grep, this is compiler-accurate — it won't match same-named symbols in other scopes or files. Returns each reference's file, line, column, and a source excerpt. Prefer this over search_content when working with Rust symbols. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_references","parameters":{"properties":{"column":{"description":"1-based column number of the symbol (point anywhere on the symbol's name).","type":"integer"},"include_declaration":{"description":"Whether to include the declaration site itself in the results. Default: true.","type":"boolean"},"line":{"description":"1-based line number of the symbol (point anywhere on the symbol's name).","type":"integer"},"path":{"description":"The .rs file containing the symbol (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"},{"function":{"description":"List valid code completions (methods, fields, functions, variables) at a cursor position in a Rust file, via rust-analyzer. Use to discover what members a type has or what identifiers are in scope, without reading the source. Requires the LSP server to be running (lsp = on in config, or /lsp on).","name":"lsp_completion","parameters":{"properties":{"column":{"description":"1-based column number of the cursor position.","type":"integer"},"line":{"description":"1-based line number of the cursor position.","type":"integer"},"path":{"description":"The .rs file to complete in (absolute path).","type":"string"}},"required":["path","line","column"],"type":"object"}},"type":"function"}],"top_p":0.95}
